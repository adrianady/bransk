# ChronoKG Configuration
# Copy to .env and fill in your values

# ── LLM Provider ──
# Default: "auto" (DeepSeek when an API key is set, otherwise Ollama)
# Options: "auto", "ollama", "deepseek", or "mock" (offline development/tests)
LLM_PROVIDER=ollama

# Ollama (Reasonix default — no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# DeepSeek (alternative — requires API key)
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_MODEL=deepseek-flash

# Optional native OpenCode server authentication username (default: opencode).
# The server URL and project directory are configured in ChronoKG → AI status
# → Configurează OpenCode nativ; the HTTP API is experimental.
# OPENCODE_SERVER_USERNAME=opencode
# If using Basic Auth, pin the same URL configured in ChronoKG and set the
# password only in backend/.env or the backend process environment. The URL pin
# prevents a writable SQLite setting from redirecting the credential.
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_PASSWORD=

# Optional web-search providers (fall back to DuckDuckGo when empty)
# SERPER_API_KEY=
# BRAVE_API_KEY=

# Optional data locations (defaults: backend/data/chronokg.db, backend/data/studies)
# CHRONOKG_DB_PATH=C:\bransk\chronokg\backend\data\chronokg.db
# CHRONOKG_STUDIES_DIR=C:\bransk\chronokg\backend\data\studies

# ── Full-text download (studies) ──
# Unpaywall (and polite OpenAlex calls) need a real contact address; without it
# Unpaywall answers 422 and open-access PDFs are missed.
# CHRONOKG_CONTACT_EMAIL=you@example.com
# Where downloaded PDFs and extracted text live (defaults: backend/data/studies,
# backend/data/studytext — keep them on the same disk as the project).
# CHRONOKG_STUDIES_DIR=
# CHRONOKG_STUDYTEXT_DIR=

# Server
HOST=0.0.0.0
PORT=8000

# ── Network access token ──
# When set, every /api/* call needs this token (Authorization: Bearer <token>).
# `start.sh -n` generates one automatically and keeps it in
# backend/data/auth-token, so the phone only asks for it once. Leave empty for
# the usual local-first, no-login behaviour.
# CHRONOKG_AUTH_TOKEN=

# ChronoKG Configuration
# Copy to .env and fill in your values

# ── LLM Provider ──
# Default: "ollama" (uses local Ollama instance, no API key needed)
# Options: "ollama" or "deepseek"
LLM_PROVIDER=ollama

# Ollama (Reasonix default — no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct-q4_K_M

# DeepSeek (alternative — requires API key)
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_MODEL=deepseek-chat

# Server
HOST=0.0.0.0
PORT=8000

__pycache__/
*.pyc
backend/data/
backend/.venv/
backend/.venv-test/
.env
# Backups and variants too (.env.backup-*, .env.local, …). The plain `.env`
# pattern does not catch them, and a backup holds the same API key.
.env.*
!backend/.env.example
frontend/node_modules/
frontend/dist/
.agents/
CHRONOKG_DETAILED_REVIEW.md
.DS_Store
.chunkhound/
.chunkhound.db
.chunkhound.db.root.json
.chunkhound.json
.pytest_cache/
.coverage
# OpenCode project config contains the API key — never commit it
opencode.json

# Audit/review documents live outside the repository (../docs-audit/), so the
# repo carries only the runnable program.
CHRONOKG_*.md
documentation/

# TypeScript incremental build cache
frontend/*.tsbuildinfo

# One-off local tooling scripts (design audits) stay outside the repo
frontend/.design-*.mjs
frontend/.contrast-*.mjs

# build artefacts accidentally created at the repo root
node_modules/

# Test runner artefacts (Playwright/Vitest) — never part of the program
frontend/test-results/
frontend/playwright-report/
frontend/.vitest/
coverage/
